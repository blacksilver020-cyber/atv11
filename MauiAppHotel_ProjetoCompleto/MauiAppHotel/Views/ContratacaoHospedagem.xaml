<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.ContratacaoHospedagem"
             Title="Hospedagem"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F4F0E8">
    <ScrollView>
        <VerticalStackLayout Padding="22,28" Spacing="18">
            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                <VerticalStackLayout Spacing="1">
                    <Label Text="HOTEL" FontSize="12" CharacterSpacing="4"
                           TextColor="#B47A3C" FontAttributes="Bold" HorizontalTextAlignment="Start" />
                    <Label Text="HORIZONTE" FontSize="27" CharacterSpacing="2"
                           TextColor="#173F3A" FontAttributes="Bold" HorizontalTextAlignment="Start" />
                    <Label Text="CONFORTO, DESCANSO E BOAS MEMÓRIAS"
                           FontSize="9" CharacterSpacing="1.2" TextColor="#69736D" HorizontalTextAlignment="Start" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="SOBRE" Clicked="OnAboutClicked"
                        FontSize="11" FontAttributes="Bold" CharacterSpacing="1"
                        TextColor="#173F3A" BackgroundColor="#E6DED0"
                        CornerRadius="14" Padding="15,10" />
            </Grid>

            <Border BackgroundColor="#173F3A" StrokeThickness="0"
                    StrokeShape="RoundRectangle 24" Padding="22">
                <VerticalStackLayout Spacing="9">
                    <Label Text="SUA PRÓXIMA VIAGEM COMEÇA AQUI"
                           FontSize="10" CharacterSpacing="1.5"
                           TextColor="#E8C99F" FontAttributes="Bold" HorizontalTextAlignment="Start" />
                    <Label Text="Um lugar para&#10;chamar de seu refúgio."
                           FontSize="27" LineHeight="1.1" TextColor="#FFFFFF"
                           FontAttributes="Bold" HorizontalTextAlignment="Start" />
                    <Label Text="Escolha sua acomodação e prepare-se para viver dias especiais."
                           FontSize="13" TextColor="#E4EAE5" HorizontalTextAlignment="Start" />
                    <Label Text="✦  HOSPEDAGEM COM EXPERIÊNCIA E ACOLHIMENTO"
                           FontSize="9" CharacterSpacing="0.7" TextColor="#E8C99F" HorizontalTextAlignment="Start" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="3">
                <Label Text="Planeje sua estadia" FontSize="22"
                       TextColor="#173F3A" FontAttributes="Bold" HorizontalTextAlignment="Start" />
                <Label Text="Informe os detalhes da sua hospedagem."
                       FontSize="13" TextColor="#69736D" HorizontalTextAlignment="Start" />
            </VerticalStackLayout>

            <Border BackgroundColor="#FFFFFF" Stroke="#E5DED2" StrokeThickness="1"
                    StrokeShape="RoundRectangle 22" Padding="18">
                <VerticalStackLayout Spacing="15">
                    <Label Text="HÓSPEDES" FontSize="11" CharacterSpacing="1.5"
                           TextColor="#B47A3C" FontAttributes="Bold" HorizontalTextAlignment="Start" />
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="12">
                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                            <Label Text="Adultos" FontSize="15" TextColor="#263D38" HorizontalTextAlignment="Start" />
                            <Label Text="A partir de 13 anos" FontSize="11" TextColor="#87908A" HorizontalTextAlignment="Start" />
                        </VerticalStackLayout>
                        <HorizontalStackLayout Grid.Row="0" Grid.Column="1" Spacing="8" VerticalOptions="Center">
                            <Label x:Name="lblAdultos" Text="2" FontSize="16" FontAttributes="Bold"
                                   TextColor="#173F3A" VerticalTextAlignment="Center" />
                            <Stepper x:Name="stp_adultos" Minimum="1" Maximum="8" Value="2"
                                     Increment="1" ValueChanged="OnAdultsChanged" />
                        </HorizontalStackLayout>
                        <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="2">
                            <Label Text="Crianças" FontSize="15" TextColor="#263D38" HorizontalTextAlignment="Start" />
                            <Label Text="Até 12 anos" FontSize="11" TextColor="#87908A" HorizontalTextAlignment="Start" />
                        </VerticalStackLayout>
                        <HorizontalStackLayout Grid.Row="1" Grid.Column="1" Spacing="8" VerticalOptions="Center">
                            <Label x:Name="lblCriancas" Text="0" FontSize="16" FontAttributes="Bold"
                                   TextColor="#173F3A" VerticalTextAlignment="Center" />
                            <Stepper x:Name="stp_criancas" Minimum="0" Maximum="8" Value="0"
                                     Increment="1" ValueChanged="OnChildrenChanged" />
                        </HorizontalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#EEE8DE" />
                    <VerticalStackLayout Spacing="7">
                        <Label Text="ESCOLHA SUA ACOMODAÇÃO" FontSize="11" CharacterSpacing="1.2"
                               TextColor="#B47A3C" FontAttributes="Bold" HorizontalTextAlignment="Start" />
                        <Picker x:Name="pck_quarto" Title="Selecione uma suíte"
                                TextColor="#263D38" TitleColor="#87908A" BackgroundColor="#F8F6F1" />
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="#EEE8DE" />
                    <VerticalStackLayout Spacing="10">
                        <Label Text="PERÍODO DA ESTADIA" FontSize="11" CharacterSpacing="1.2"
                               TextColor="#B47A3C" FontAttributes="Bold" HorizontalTextAlignment="Start" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="5">
                                <Label Text="Check-in" FontSize="12" TextColor="#69736D" HorizontalTextAlignment="Start" />
                                <DatePicker x:Name="dtpck_checkin" Format="dd/MM/yyyy"
                                            TextColor="#173F3A" DateSelected="OnCheckInDateSelected" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="5">
                                <Label Text="Check-out" FontSize="12" TextColor="#69736D" HorizontalTextAlignment="Start" />
                                <DatePicker x:Name="dtpck_checkout" Format="dd/MM/yyyy" TextColor="#173F3A" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>

                    <Button Text="CONTINUAR COM A RESERVA" Clicked="OnBookingClicked"
                            BackgroundColor="#C58A4A" TextColor="#FFFFFF"
                            FontSize="12" FontAttributes="Bold" CharacterSpacing="1"
                            CornerRadius="15" HeightRequest="54" />
                </VerticalStackLayout>
            </Border>

            <Label Text="HOTEL HORIZONTE  •  SUA ESTADIA, SEU MOMENTO"
                   FontSize="9" CharacterSpacing="0.7" TextColor="#87908A"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
