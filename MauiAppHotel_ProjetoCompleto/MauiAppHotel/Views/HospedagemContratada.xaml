<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.HospedagemContratada"
             Title="Resumo da hospedagem"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F4F0E8">
    <ScrollView>
        <VerticalStackLayout Padding="24,34" Spacing="20" VerticalOptions="Center">
            <Label Text="HOTEL HORIZONTE" FontSize="12" CharacterSpacing="3"
                   TextColor="#B47A3C" FontAttributes="Bold" HorizontalTextAlignment="Center" />
            <Border BackgroundColor="#173F3A" StrokeThickness="0"
                    StrokeShape="RoundRectangle 26" Padding="24">
                <VerticalStackLayout Spacing="12">
                    <Label Text="✓" FontSize="42" TextColor="#E8C99F" HorizontalTextAlignment="Center" />
                    <Label Text="Resumo da sua hospedagem" FontSize="24"
                           TextColor="#FFFFFF" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                    <Label Text="Confira os dados informados para sua estadia."
                           FontSize="13" TextColor="#E4EAE5" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>
            <Border BackgroundColor="#FFFFFF" Stroke="#E5DED2" StrokeThickness="1"
                    StrokeShape="RoundRectangle 22" Padding="20">
                <VerticalStackLayout Spacing="15">
                    <Label Text="RESUMO DA ESTADIA" FontSize="11" CharacterSpacing="1.5"
                           TextColor="#B47A3C" FontAttributes="Bold" HorizontalTextAlignment="Start" />
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Acomodação" FontSize="12" TextColor="#87908A" HorizontalTextAlignment="Start" />
                        <Label x:Name="lblSuite" FontSize="17" TextColor="#173F3A"
                               FontAttributes="Bold" HorizontalTextAlignment="Start" />
                    </VerticalStackLayout>
                    <BoxView HeightRequest="1" Color="#EEE8DE" />
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Hóspedes" FontSize="12" TextColor="#87908A" HorizontalTextAlignment="Start" />
                        <Label x:Name="lblHospedes" FontSize="15" TextColor="#263D38" HorizontalTextAlignment="Start" />
                    </VerticalStackLayout>
                    <BoxView HeightRequest="1" Color="#EEE8DE" />
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Período" FontSize="12" TextColor="#87908A" HorizontalTextAlignment="Start" />
                        <Label x:Name="lblDatas" FontSize="15" TextColor="#263D38" HorizontalTextAlignment="Start" />
                    </VerticalStackLayout>
                    <BoxView HeightRequest="1" Color="#EEE8DE" />
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Duração" FontSize="12" TextColor="#87908A" HorizontalTextAlignment="Start" />
                        <Label x:Name="lblNoites" FontSize="15" TextColor="#263D38"
                               FontAttributes="Bold" HorizontalTextAlignment="Start" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
            <Label Text="Prévia acadêmica: esta tela não efetua uma reserva real ou pagamento."
                   FontSize="11" TextColor="#69736D" HorizontalTextAlignment="Center" />
            <Button Text="VOLTAR À HOSPEDAGEM" Clicked="OnBackClicked"
                    BackgroundColor="#C58A4A" TextColor="#FFFFFF"
                    FontSize="12" FontAttributes="Bold" CharacterSpacing="1"
                    CornerRadius="15" HeightRequest="52" />
            <Button Text="SOBRE O PROJETO" Clicked="OnAboutClicked"
                    BackgroundColor="Transparent" TextColor="#173F3A"
                    FontSize="11" FontAttributes="Bold" CharacterSpacing="1" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
